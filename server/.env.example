# ============================================================
# ATS Resume Analyzer: server configuration
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit .env or put real secrets in this file.
# ============================================================

# ── Required ────────────────────────────────────────────────
# Local MongoDB, or a MongoDB Atlas connection string:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ats-resume-analyzer?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ats-resume-analyzer

# Long random string used to sign login tokens (min 32 chars in production).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── AI suggestions (optional) ───────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
# Leave empty to run with rule-based recommendations only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# AI_TIMEOUT_MS=30000

# ── Server ──────────────────────────────────────────────────
# NODE_ENV=production
# PORT=5000
# JWT_EXPIRES_IN=7d

# Allowed browser origins (comma-separated) when the web app is hosted on a
# DIFFERENT origin than the API. Leave empty for single-origin deployments.
# FRONTEND_URL=https://app.example.com

# Number of reverse proxies in front of the server (Render, Railway, Nginx, ...).
# Required for correct rate limiting behind a proxy. Use 0 when not proxied.
# TRUST_PROXY=1

# ── Limits ──────────────────────────────────────────────────
# MAX_UPLOAD_MB=5
# ANALYSES_PER_HOUR=20

# ── Serving the built web app from this process ─────────────
# SERVE_CLIENT=true
# CLIENT_DIST_DIR=/absolute/path/to/client/dist

# LOG_LEVEL=info
