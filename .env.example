# Used by docker-compose.yml (the server's own settings live in server/.env.example).
# Copy to .env and fill in. NEVER commit .env.

# Required. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Without it the app still works with rule-based recommendations.
GEMINI_API_KEY=

# Set to 1 when running behind one reverse proxy / load balancer (needed for correct rate limiting).
TRUST_PROXY=0

# Host port to publish the app on.
PORT=5000
